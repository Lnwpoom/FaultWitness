{
  "name": "faultwitness",
  "version": "0.1.0",
  "private": true,
  "description": "Two-Probe network fault localiser with an explainable Diagnosis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "lab": "node --disable-warning=ExperimentalWarning lab/cli.ts",
    "collector": "node --disable-warning=ExperimentalWarning src/collector/main.ts",
    "probe": "node --disable-warning=ExperimentalWarning src/probe/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
